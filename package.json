  },
  "homepage": "https://github.com/ssaakova8-pixel/larry-toad-video#readme",
  "dependencies": {
    "@remotion/cli": "^4.0.523",
    "@remotion/player": "^4.0.523",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "remotion": "^4.0.523"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.3"
  }
